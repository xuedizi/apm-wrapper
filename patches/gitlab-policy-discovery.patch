+"""Focused regressions for self-managed GitLab organization policy discovery."""
+
+from __future__ import annotations
+
+import hashlib
+import json
+import time
+from pathlib import Path
+from unittest.mock import MagicMock, patch
+from urllib.parse import urlparse
+
+import pytest
+import requests
+
+from apm_cli.policy import discovery
+from apm_cli.policy.discovery import (
+    DEFAULT_CACHE_TTL,
+    PolicyFetchResult,
+    _cache_key,
+    _fetch_chain_parent,
+    _get_cache_dir,
+    _read_cache_entry,
+    _write_cache,
+    discover_policy_with_chain,
+)
+from apm_cli.policy.inheritance import PolicyInheritanceError
+from apm_cli.policy.schema import ApmPolicy, DependencyPolicy
+
+HOST = "gitlab.auto-pai.cn"
+LEAF_PROJECT = "tc-platform/.github-private"
+LEAF_REF = f"{HOST}/{LEAF_PROJECT}"
+PROJECT_WITH_404 = "team404/.github-private"
+REF_WITH_404 = f"{HOST}/{PROJECT_WITH_404}"
+POLICY_YAML = """\
+name: company-policy
+enforcement: block
+dependencies:
+  deny: [blocked/package]
+custom_field: preserve-this-warning
+"""
+
+
+def _gitlab_repo_fetch():
+    assert hasattr(discovery, "_fetch_from_gitlab_repo"), (
+        "GitLab repository policy helper is missing"
+    )
+    return discovery._fetch_from_gitlab_repo
+
+
+def _gitlab_transport():
+    assert hasattr(discovery, "_fetch_gitlab_contents"), (
+        "GitLab raw-file transport helper is missing"
+    )
+    return discovery._fetch_gitlab_contents
+
+
+def _response(status_code: int, text: str = "", **headers: str) -> MagicMock:
+    response = MagicMock()
+    response.status_code = status_code
+    response.text = text
+    response.headers = headers
+    return response
+
+
+def _make_stale_cache(tmp_path: Path, repo_ref: str = LEAF_REF) -> ApmPolicy:
+    policy = ApmPolicy(
+        name="cached-company-policy",
+        enforcement="block",
+        dependencies=DependencyPolicy(deny=("cached/blocked",)),
+    )
+    _write_cache(repo_ref, policy, tmp_path, warnings=["cached warning"])
+    meta_file = _get_cache_dir(tmp_path) / f"{_cache_key(repo_ref)}.meta.json"
+    metadata = json.loads(meta_file.read_text(encoding="utf-8"))
+    metadata["cached_at"] = time.time() - DEFAULT_CACHE_TTL - 100
+    meta_file.write_text(json.dumps(metadata), encoding="utf-8")
+    return policy
+
+
+def test_auto_discovery_routes_gitlab_candidate_and_forwards_controls(tmp_path):
+    gitlab_fetch = MagicMock(
+        return_value=PolicyFetchResult(source=f"org:{LEAF_REF}", outcome="found")
+    )
+
+    with (
+        patch.object(
+            discovery,
+            "_extract_org_from_git_remote",
+            return_value=("tc-platform", HOST),
+        ),
+        patch.object(discovery, "_fetch_from_gitlab_repo", gitlab_fetch, create=True),
+        patch.object(discovery, "_fetch_from_repo") as github_fetch,
+    ):
+        result = discovery._auto_discover(
+            tmp_path,
+            no_cache=True,
+            expected_hash="sha256:" + "a" * 64,
+            cache_only=True,
+        )
+
+    assert result.outcome == "found"
+    gitlab_fetch.assert_called_once_with(
+        project_path=LEAF_PROJECT,
+        host=HOST,
+        project_root=tmp_path,
+        no_cache=True,
+        expected_hash="sha256:" + "a" * 64,
+        cache_only=True,
+    )
+    github_fetch.assert_not_called()
+
+
+def test_auto_discovery_preserves_candidate_cascade_for_gitlab(tmp_path):
+    gitlab_fetch = MagicMock(
+        side_effect=[
+            PolicyFetchResult(outcome="absent"),
+            PolicyFetchResult(outcome="absent"),
+            PolicyFetchResult(source=f"org:{HOST}/tc-platform/.apm", outcome="found"),
+        ]
+    )
+    with (
+        patch.object(
+            discovery,
+            "_extract_org_from_git_remote",
+            return_value=("tc-platform", HOST),
+        ),
+        patch.object(discovery, "_fetch_from_gitlab_repo", gitlab_fetch, create=True),
+    ):
+        result = discovery._auto_discover(tmp_path, no_cache=True, cache_only=True)
+
+    assert result.outcome == "found"
+    assert [call.kwargs["project_path"] for call in gitlab_fetch.call_args_list] == [
+        "tc-platform/.github-private",
+        "tc-platform/.github",
+        "tc-platform/.apm",
+    ]
+    assert all(call.kwargs["no_cache"] is True for call in gitlab_fetch.call_args_list)
+    assert all(call.kwargs["cache_only"] is True for call in gitlab_fetch.call_args_list)
+
+
+def test_repository_fresh_cache_hit_suppresses_transport(tmp_path):
+    expected = ApmPolicy(name="cached", enforcement="block")
+    _write_cache(LEAF_REF, expected, tmp_path)
+
+    with patch.object(
+        discovery,
+        "_fetch_gitlab_contents",
+        side_effect=AssertionError("fresh cache hit reached GitLab transport"),
+        create=True,
+    ) as transport:
+        result = _gitlab_repo_fetch()(
+            project_path=LEAF_PROJECT,
+            host=HOST,
+            project_root=tmp_path,
+        )
+
+    assert result.policy == expected
+    assert result.cached is True
+    assert result.source == f"org:{LEAF_REF}"
+    transport.assert_not_called()
+
+
+def test_repository_cache_only_miss_suppresses_transport(tmp_path):
+    with patch.object(
+        discovery,
+        "_fetch_gitlab_contents",
+        side_effect=AssertionError("cache-only lookup reached GitLab transport"),
+        create=True,
+    ) as transport:
+        result = _gitlab_repo_fetch()(
+            project_path=LEAF_PROJECT,
+            host=HOST,
+            project_root=tmp_path,
+            cache_only=True,
+        )
+
+    assert result.outcome == "absent"
+    assert result.policy is None
+    assert result.source == f"org:{LEAF_REF}"
+    transport.assert_not_called()
+
+
+def test_repository_success_preserves_source_hash_warnings_and_cache(tmp_path):
+    expected_hash = "sha256:" + hashlib.sha256(POLICY_YAML.encode()).hexdigest()
+    with patch.object(
+        discovery,
+        "_fetch_gitlab_contents",
+        return_value=(POLICY_YAML, None),
+        create=True,
+    ):
+        result = _gitlab_repo_fetch()(
+            project_path=LEAF_PROJECT,
+            host=HOST,
+            project_root=tmp_path,
+            no_cache=True,
+            expected_hash=expected_hash,
+        )
+
+    assert result.outcome == "found"
+    assert result.policy is not None
+    assert result.policy.enforcement == "block"
+    assert result.source == f"org:{LEAF_REF}"
+    assert result.raw_bytes_hash == expected_hash
+    assert result.expected_hash == expected_hash
+    assert any("custom_field" in warning for warning in result.warnings)
+    cached = _read_cache_entry(LEAF_REF, tmp_path, expected_hash=expected_hash)
