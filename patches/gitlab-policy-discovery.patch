+def test_cold_gitlab_leaf_parent_merge_and_warm_cache_suppress_network(tmp_path, parent_ref):
+    leaf_yaml = f"""\
+name: child
+extends: {parent_ref}
+dependencies:
+  deny: [child/deny]
+"""
+    parent_yaml = """\
+name: parent
+enforcement: block
+dependencies:
+  require_pinned_constraint: true
+"""
+
+    def get(url: str, **_kwargs) -> MagicMock:
+        parsed = urlparse(url)
+        if "tc-platform%2F.github-private" in parsed.path:
+            return _response(200, leaf_yaml)
+        if "platform%2Fpolicy" in parsed.path:
+            return _response(200, parent_yaml)
+        raise AssertionError(f"unexpected GitLab URL: {url}")
+
+    with (
+        patch.object(
+            discovery,
+            "_extract_org_from_git_remote",
+            return_value=("tc-platform", HOST),
+        ),
+        patch.object(discovery, "_get_token_for_host", return_value=None),
+        patch.object(discovery.requests, "get", side_effect=get) as network,
+    ):
+        assert hasattr(discovery, "_fetch_from_gitlab_repo"), (
+            "GitLab repository policy helper is missing"
+        )
+        cold = discover_policy_with_chain(tmp_path)
+        network.side_effect = AssertionError("warm merged-cache read reached network")
+        warm = discover_policy_with_chain(tmp_path)
+
+    assert cold.policy is not None
+    assert cold.policy.enforcement == "block"
+    assert cold.policy.dependencies.deny == ("child/deny",)
+    assert cold.policy.dependencies.require_pinned_constraint is True
+    assert cold.cached is False
+    assert warm.cached is True
+    assert warm.policy == cold.policy
+    assert network.call_count == 2
+    cached = _read_cache_entry(LEAF_REF, tmp_path)
+    assert cached is not None
+    assert cached.chain_refs == [f"{HOST}/platform/policy", LEAF_REF]
+
+
+def test_cross_host_parent_rejected_before_token_or_http(tmp_path):
+    leaf = PolicyFetchResult(
