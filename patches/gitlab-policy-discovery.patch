+    assert cached.raw_bytes_hash == expected_hash
+    assert cached.warnings == result.warnings
+
+
+def test_repository_extending_leaf_waits_for_merged_cache(tmp_path):
+    with patch.object(
+        discovery,
+        "_fetch_gitlab_contents",
+        return_value=("name: leaf\nextends: platform/policy\n", None),
+        create=True,
