+# ---------------------------------------------------------------------------
+# GitLab policy fetch (Tinnove fork)
+# ---------------------------------------------------------------------------
+
+
+def _fetch_from_gitlab_repo(
+    *,
+    org: str,
+    repo: str,
+    host: str,
+    project_root: Path,
+    no_cache: bool = False,
+    expected_hash: str | None = None,
+) -> PolicyFetchResult:
+    """Fetch apm-policy.yml from a GitLab repo (Tinnove fork).
+
+    Mirrors :func:`_fetch_from_repo` / :func:`_fetch_from_ado_repo` (cache
+    read, garbage detection, hash-pin verification, parse, cache write) but
+    sources the file through the GitLab REST v4 API rather than the GitHub
+    Contents API. ``repo`` is the policy repository name (``.github`` by
+    convention, matching the GitHub path).
+    """
+    repo_ref = f"{host}/{org}/{repo}"
+    source_label = f"org:{repo_ref}"
+    cache_entry: _CacheEntry | None = None
+
+    if not no_cache:
+        cache_entry = _read_cache_entry(repo_ref, project_root, expected_hash=expected_hash)
+        if cache_entry is not None and not cache_entry.stale:
+            outcome = "empty" if _is_policy_empty(cache_entry.policy) else "found"
+            return PolicyFetchResult(
+                policy=cache_entry.policy,
+                source=cache_entry.source,
+                cached=True,
+                cache_age_seconds=cache_entry.age_seconds,
+                outcome=outcome,
+                raw_bytes_hash=cache_entry.raw_bytes_hash or None,
+                expected_hash=expected_hash,
+            )
+
+    content, error = _fetch_gitlab_contents(org, repo, "apm-policy.yml", host=host)
+
+    if error:
+        # 404 = no policy repo / no policy file, not an error.
+        if "404" in error:
+            return PolicyFetchResult(source=source_label, outcome="absent")
+        return _stale_fallback_or_error(cache_entry, error, source_label, "cache_miss_fetch_fail")
+
+    if content is None:
+        return PolicyFetchResult(source=source_label, outcome="absent")
+
+    garbage_result = _detect_garbage(content, repo_ref, source_label, cache_entry)
+    if garbage_result is not None:
+        return garbage_result
+
+    mismatch = _verify_hash_pin(content, expected_hash, source_label)
+    if mismatch is not None:
+        return mismatch
+
+    try:
+        policy, _warnings = load_policy(content)
+    except PolicyValidationError as e:
+        return PolicyFetchResult(
+            error=f"Invalid policy in {repo_ref}: {e}",
+            source=source_label,
+            outcome="malformed",
+        )
+
+    chain_refs = [repo_ref]
+    actual_hash = _compute_hash_normalized(content, expected_hash)
+    _write_cache(
+        repo_ref,
+        policy,
+        project_root,
+        chain_refs=chain_refs,
+        raw_bytes_hash=actual_hash,
+    )
+    outcome = "empty" if _is_policy_empty(policy) else "found"
+    return PolicyFetchResult(
+        policy=policy,
+        source=source_label,
+        outcome=outcome,
+        raw_bytes_hash=actual_hash,
+        expected_hash=expected_hash,
+    )
+
+
+def _fetch_gitlab_contents(
+    org: str,
+    repo: str,
+    file_path: str,
+    *,
+    host: str,
+) -> tuple[str | None, str | None]:
+    """Fetch a file from a GitLab repo via the REST v4 raw-file API (Tinnove fork).
+
+    Returns ``(content_string, error_string)``; exactly one is ``None``.
+
+    Uses ``GET /api/v4/projects/{url-encoded project}/repository/files/{url-
+    encoded path}/raw?ref=...`` -- the same endpoint the dependency downloader
+    uses for GitLab ``path:`` files. The project's default branch is not known
+    without an extra API round-trip, so the conventional branches ``main`` and
+    ``master`` are tried in order; a 404 on the last candidate means "no policy".
+
+    The ``PRIVATE-TOKEN`` header carries a GitLab PAT/OAuth token resolved from
+    the environment / credential helper via :func:`_get_token_for_host`; no
+    token is ever baked in.
+    """
+    project_path = f"{org}/{repo}"
+    api_base = f"https://{host}/api/v4"
+    enc_proj = quote(project_path, safe="")
+    enc_file = quote(file_path, safe="")
+
+    token = _get_token_for_host(host)
+    headers = {"Accept": "application/json"}
+    if token:
+        # GitLab accepts a PAT/OAuth token via the PRIVATE-TOKEN header.
+        headers["PRIVATE-TOKEN"] = token
+
+    candidate_refs = ("main", "master")
+    last_error: str | None = None
+    for ref in candidate_refs:
+        api_url = (
+            f"{api_base}/projects/{enc_proj}/repository/files/{enc_file}/raw"
+            f"?ref={quote(ref, safe='')}"
+        )
+        try:
+            resp = requests.get(api_url, headers=headers, timeout=10, allow_redirects=False)
+            if resp.status_code == 404:
+                # File or branch absent -- try the next candidate branch.
+                last_error = "404: Policy file not found"
+                continue
+            if resp.status_code == 401:
+                return None, f"401: Authentication required for {project_path}"
+            if resp.status_code == 403:
+                return None, f"403: Access denied to {project_path}"
+            if resp.status_code == 410:
+                return None, (
+                    f"410: GitLab REST API disabled on {host}; "
+                    "cannot auto-discover org policy over the API"
+                )
+            if 300 <= resp.status_code < 400:
+                location = resp.headers.get("Location", "<no Location header>")
+                return None, (
+                    f"Refusing HTTP redirect ({resp.status_code}) from {api_url} to {location}"
+                )
+            if resp.status_code != 200:
+                return None, f"HTTP {resp.status_code} fetching policy from {project_path}"
+            return resp.text, None
+        except requests.exceptions.Timeout:
+            return None, f"Timeout fetching policy from {project_path}"
+        except requests.exceptions.ConnectionError:
+            return None, f"Connection error fetching policy from {project_path}"
+        except Exception as e:
+            return None, f"Error fetching policy from {project_path}: {e}"
+
+    return None, last_error or "404: Policy file not found"
+
