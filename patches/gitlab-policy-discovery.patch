+            "_extract_org_from_git_remote",
+            return_value=("tc-platform", HOST),
+        ),
+        patch.object(discovery, "_fetch_from_gitlab_repo", return_value=leaf, create=True),
+        patch.object(discovery, "_get_token_for_host") as token,
+        patch.object(discovery.requests, "get") as network,
+    ):
+        with pytest.raises(PolicyInheritanceError, match="cross-host reference rejected"):
+            discover_policy_with_chain(tmp_path)
+
+    token.assert_not_called()
+    network.assert_not_called()
