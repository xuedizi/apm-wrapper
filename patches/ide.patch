+def test_explicit_tc_installs_to_shared_claude_directory(tmp_path: Path) -> None:
+    """TC is selectable explicitly and deploys through the shared .claude root."""
+    from apm_cli.install.phases.targets import run
+    from apm_cli.models.apm_package import APMPackage
+
+    project = tmp_path / "project"
+    project.mkdir()
+    (project / "apm.yml").write_text("name: demo\nversion: 0.1.0\n", encoding="utf-8")
+    ctx = _make_ctx(tmp_path, target_override="tc")
+    ctx.project_root = project
+    ctx.apm_package = APMPackage.from_apm_yml(project / "apm.yml")
+
+    run(ctx)
+
+    assert [target.name for target in ctx.targets] == ["tc"]
+    assert ctx.targets[0].root_dir == ".claude"
+    assert (project / ".claude").is_dir()
+
