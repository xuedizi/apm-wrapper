index 0000000..fb0e993
--- /dev/null
+++ b/tests/integration/test_literal_ref_refresh_convergence.py
@@ -0,0 +1,303 @@
+"""Hermetic full-pipeline regressions for literal-ref refresh convergence."""
+
+from __future__ import annotations
+
+import hashlib
+import shutil
+from datetime import datetime
+from pathlib import Path
+from types import SimpleNamespace
+from unittest.mock import patch
+
+import pytest
+import yaml
+from click.testing import CliRunner
+
+from apm_cli.cli import cli
+from apm_cli.deps.lockfile import LockedDependency, LockFile
+from apm_cli.install.phases.lockfile import LockfileBuilder
+from apm_cli.models.apm_package import (
+    APMPackage,
+    DependencyReference,
+    PackageInfo,
+    clear_apm_yml_cache,
+)
+from apm_cli.models.dependency.types import GitReferenceType, ResolvedReference
+
+_PATCH_UPDATES = "apm_cli.commands._helpers.check_for_updates"
+
+
+class _GraphDownloader:
+    """Materialise a three-repository literal-tag graph without network I/O."""
+
+    def __init__(self) -> None:
+        self.calls: list[tuple[str, str]] = []
+        self.moved_parent_tag = False
+
+    def install(self, monkeypatch: pytest.MonkeyPatch) -> None:
+        recorder = self
+
+        def _resolved_reference(dep: DependencyReference) -> ResolvedReference:
+            ref = dep.reference or "main"
+            marker = f"{dep.repo_url}@{ref}"
+            if dep.repo_url == "acme/parent" and recorder.moved_parent_tag:
+                marker += "-moved"
+            return ResolvedReference(
+                original_ref=ref,
+                ref_type=GitReferenceType.TAG,
+                resolved_commit=hashlib.sha256(marker.encode("utf-8")).hexdigest()[:40],
+                ref_name=ref,
+            )
+
+        def _fake_download(self, repo_ref, target_path, *args, **kwargs):
+            dep = (
+                repo_ref
+                if isinstance(repo_ref, DependencyReference)
+                else DependencyReference.parse(str(repo_ref))
+            )
+            ref = dep.reference or "main"
+            recorder.calls.append((dep.repo_url, ref))
+            target_path = Path(target_path)
+            target_path.mkdir(parents=True, exist_ok=True)
+
+            version = "2.0.0" if ref == "v2.0.0" else "1.0.0"
+            dependencies: list[str] = []
+            if dep.repo_url == "acme/parent":
+                dependencies = [
+                    f"acme/child-a#v{version}",
+                    f"acme/child-b#v{version}",
+                ]
+
+            manifest = {
+                "name": dep.repo_url.rsplit("/", 1)[-1],
+                "version": version,
+                "dependencies": {"apm": dependencies, "mcp": []},
+            }
+            (target_path / "apm.yml").write_text(
+                yaml.safe_dump(manifest),
+                encoding="utf-8",
+            )
+            marker = f"{dep.repo_url}@{ref}"
+            if dep.repo_url == "acme/parent" and recorder.moved_parent_tag:
+                marker += "-moved"
+            (target_path / "payload.txt").write_text(marker + "\n", encoding="utf-8")
+
+            clear_apm_yml_cache()
+            package = APMPackage.from_apm_yml(target_path / "apm.yml")
+            return PackageInfo(
+                package=package,
+                install_path=target_path,
+                installed_at=datetime.now().isoformat(),
+                dependency_ref=dep,
+                resolved_reference=_resolved_reference(dep),
+            )
+
+        def _fake_resolve(self, repo_ref):
+            dep = (
+                repo_ref
+                if isinstance(repo_ref, DependencyReference)
+                else DependencyReference.parse(str(repo_ref))
+            )
+            return _resolved_reference(dep)
+
+        from apm_cli.deps import github_downloader
+
+        monkeypatch.setattr(
+            github_downloader.GitHubPackageDownloader,
+            "download_package",
+            _fake_download,
+        )
+        monkeypatch.setattr(
+            github_downloader.GitHubPackageDownloader,
+            "resolve_git_reference",
+            _fake_resolve,
+        )
+
+
+@pytest.fixture(autouse=True)
+def _clear_package_cache():
+    clear_apm_yml_cache()
+    yield
+    clear_apm_yml_cache()
+
+
+def _write_project(project: Path, parent_ref: str) -> None:
+    project.mkdir(parents=True, exist_ok=True)
+    (project / ".github").mkdir(exist_ok=True)
+    (project / "apm.yml").write_text(
+        yaml.safe_dump(
+            {
+                "name": "literal-refresh-consumer",
+                "version": "1.0.0",
+                "target": "copilot",
+                "dependencies": {
+                    "apm": [f"acme/parent#{parent_ref}"],
+                    "mcp": [],
+                },
+            }
+        ),
+        encoding="utf-8",
+    )
+    clear_apm_yml_cache()
+
+
+def _install(
+    runner: CliRunner,
+    project: Path,
+    monkeypatch: pytest.MonkeyPatch,
+    *args: str,
+):
+    monkeypatch.chdir(project)
+    with patch(_PATCH_UPDATES, return_value=None):
+        return runner.invoke(cli, ["install", *args], catch_exceptions=False)
+
+
+def _locked_refs(project: Path) -> dict[str, str | None]:
+    data = yaml.safe_load((project / "apm.lock.yaml").read_text(encoding="utf-8"))
+    dependencies = data["dependencies"]
+    rows = dependencies.values() if isinstance(dependencies, dict) else dependencies
+    return {row["repo_url"]: row.get("resolved_ref") for row in rows}
+
+
+def _lock_rows(project: Path) -> list[dict]:
+    data = yaml.safe_load((project / "apm.lock.yaml").read_text(encoding="utf-8"))
+    dependencies = data["dependencies"]
+    return list(dependencies.values()) if isinstance(dependencies, dict) else dependencies
+
+
+def test_changed_parent_literal_ref_converges_transitive_graph_in_one_refresh(
+    tmp_path: Path,
+    monkeypatch: pytest.MonkeyPatch,
+) -> None:
+    project = tmp_path / "consumer"
+    runner = CliRunner()
+    downloader = _GraphDownloader()
+    downloader.install(monkeypatch)
+
+    _write_project(project, "v1.0.0")
+    first = _install(runner, project, monkeypatch)
+    assert first.exit_code == 0, first.output
+    assert _locked_refs(project) == {
+        "acme/parent": "v1.0.0",
+        "acme/child-a": "v1.0.0",
+        "acme/child-b": "v1.0.0",
+    }
+
+    _write_project(project, "v2.0.0")
+    calls_before_upgrade = len(downloader.calls)
+    upgraded = _install(runner, project, monkeypatch, "--refresh")
+    assert upgraded.exit_code == 0, upgraded.output
+    assert _locked_refs(project) == {
+        "acme/parent": "v2.0.0",
+        "acme/child-a": "v2.0.0",
+        "acme/child-b": "v2.0.0",
+    }
+    upgrade_calls = downloader.calls[calls_before_upgrade:]
+    assert sorted(upgrade_calls) == [
+        ("acme/child-a", "v2.0.0"),
+        ("acme/child-b", "v2.0.0"),
+        ("acme/parent", "v2.0.0"),
+    ]
+    for repo in ("parent", "child-a", "child-b"):
+        payload = project / "apm_modules" / "acme" / repo / "payload.txt"
+        assert "@v2.0.0" in payload.read_text(encoding="utf-8")
+
+    calls_before_noop = len(downloader.calls)
+    noop = _install(runner, project, monkeypatch, "--refresh")
+    assert noop.exit_code == 0, noop.output
+    assert len(downloader.calls) == calls_before_noop
+
+
+def test_moved_unchanged_literal_tag_fails_hash_check_and_preserves_lock(
+    tmp_path: Path,
+    monkeypatch: pytest.MonkeyPatch,
+) -> None:
+    project = tmp_path / "consumer"
+    runner = CliRunner()
+    downloader = _GraphDownloader()
+    downloader.install(monkeypatch)
+
+    _write_project(project, "v1.0.0")
+    first = _install(runner, project, monkeypatch)
+    assert first.exit_code == 0, first.output
+    lock_path = project / "apm.lock.yaml"
+    old_lock = lock_path.read_bytes()
+
+    parent_path = project / "apm_modules" / "acme" / "parent"
+    shutil.rmtree(parent_path)
+    downloader.moved_parent_tag = True
+
+    refreshed = _install(runner, project, monkeypatch, "--refresh")
+    assert refreshed.exit_code != 0
+    assert "Content hash mismatch" in refreshed.output
+    assert not parent_path.exists()
+    assert lock_path.read_bytes() == old_lock
+
+
+def test_frozen_replay_preserves_existing_marketplace_provenance(
+    tmp_path: Path,
+    monkeypatch: pytest.MonkeyPatch,
+) -> None:
+    project = tmp_path / "consumer"
+    runner = CliRunner()
+    downloader = _GraphDownloader()
+    downloader.install(monkeypatch)
+
+    _write_project(project, "v2.0.0")
+    first = _install(runner, project, monkeypatch)
+    assert first.exit_code == 0, first.output
+
+    lock_path = project / "apm.lock.yaml"
+    lock_data = yaml.safe_load(lock_path.read_text(encoding="utf-8"))
+    rows = lock_data["dependencies"]
+    rows = list(rows.values()) if isinstance(rows, dict) else rows
+    parent = next(row for row in rows if row["repo_url"] == "acme/parent")
+    parent["discovered_via"] = "fixture-marketplace"
+    parent["marketplace_plugin_name"] = "fixture-parent"
+    lock_path.write_text(yaml.safe_dump(lock_data, sort_keys=False), encoding="utf-8")
+
+    frozen = _install(runner, project, monkeypatch, "--frozen")
+    assert frozen.exit_code == 0, frozen.output
+    replayed_parent = next(
+        row for row in _lock_rows(project) if row["repo_url"] == "acme/parent"
+    )
+    assert replayed_parent["discovered_via"] == "fixture-marketplace"
+    assert replayed_parent["marketplace_plugin_name"] == "fixture-parent"
+
+
+@pytest.mark.parametrize(
+    ("previous_commit", "current_commit"),
+    [
+        (None, None),
+        ("a" * 40, "b" * 40),
+    ],
+)
+def test_marketplace_provenance_is_not_inherited_without_same_nonempty_commit(
+    previous_commit: str | None,
+    current_commit: str | None,
+) -> None:
+    previous = LockedDependency(
+        repo_url="acme/parent",
+        resolved_commit=previous_commit,
+        discovered_via="fixture-marketplace",
+        marketplace_plugin_name="fixture-parent",
+        source_url="https://example.invalid/marketplace.yml",
+        source_digest="sha256:fixture",
+    )
+    current = LockedDependency(
+        repo_url="acme/parent",
+        resolved_commit=current_commit,
+    )
+    existing_lockfile = LockFile()
+    existing_lockfile.add_dependency(previous)
+    rebuilt_lockfile = LockFile()
+    rebuilt_lockfile.add_dependency(current)
+
+    LockfileBuilder(
+        SimpleNamespace(existing_lockfile=existing_lockfile)
+    )._preserve_existing_marketplace_provenance(rebuilt_lockfile)
+
+    assert current.discovered_via is None
+    assert current.marketplace_plugin_name is None
+    assert current.source_url is None
+    assert current.source_digest is None
