@@ -0,0 +1,122 @@
+"""Regressions for Marketplace provenance during lockfile rebuilds."""
+
+from types import SimpleNamespace
+from unittest.mock import MagicMock
+
+import pytest
+
+from apm_cli.deps.installed_package import InstalledPackage
+from apm_cli.deps.lockfile import LockedDependency, LockFile
+from apm_cli.install.context import InstallContext
+from apm_cli.install.phases.lockfile import LockfileBuilder
+from apm_cli.models.apm_package import DependencyReference
+
+
+def _lockfile_with(dependency: LockedDependency) -> LockFile:
+    lockfile = LockFile()
+    lockfile.add_dependency(dependency)
+    return lockfile
+
+
+def test_marketplace_provenance_is_preserved_for_same_nonempty_commit() -> None:
+    commit = "a" * 40
+    previous = LockedDependency(
+        repo_url="acme/parent",
+        resolved_commit=commit,
+        discovered_via="fixture-marketplace",
+        marketplace_plugin_name="fixture-parent",
+        source_url="https://example.invalid/marketplace.yml",
+        source_digest="sha256:fixture",
+    )
+    current = LockedDependency(
+        repo_url="acme/parent",
+        resolved_commit=commit,
+    )
+    rebuilt = _lockfile_with(current)
+
+    LockfileBuilder(
+        SimpleNamespace(existing_lockfile=_lockfile_with(previous))
+    )._preserve_existing_marketplace_provenance(rebuilt)
+
+    assert current.discovered_via == "fixture-marketplace"
+    assert current.marketplace_plugin_name == "fixture-parent"
+    assert current.source_url == "https://example.invalid/marketplace.yml"
+    assert current.source_digest == "sha256:fixture"
+
+
+def test_build_and_save_preserves_marketplace_provenance_on_disk(tmp_path) -> None:
+    commit = "a" * 40
+    previous = LockedDependency(
+        repo_url="acme/parent",
+        resolved_commit=commit,
+        discovered_via="fixture-marketplace",
+        marketplace_plugin_name="fixture-parent",
+        source_url="https://example.invalid/marketplace.yml",
+        source_digest="sha256:fixture",
+    )
+    existing = _lockfile_with(previous)
+    existing.write(tmp_path / "apm.lock.yaml")
+
+    dep_ref = DependencyReference(repo_url="acme/parent", reference="v2.0.0")
+    ctx = InstallContext(
+        project_root=tmp_path,
+        apm_dir=tmp_path,
+        existing_lockfile=existing,
+        logger=MagicMock(),
+        diagnostics=MagicMock(),
+        lockfile_only=True,
+    )
+    ctx.installed_packages = [
+        InstalledPackage(
+            dep_ref=dep_ref,
+            resolved_commit=commit,
+            depth=1,
+            resolved_by=None,
+        )
+    ]
+
+    LockfileBuilder(ctx).build_and_save()
+
+    written = LockFile.read(tmp_path / "apm.lock.yaml")
+    assert written is not None
+    current = written.get_dependency(dep_ref.get_unique_key())
+    assert current is not None
+    assert current.discovered_via == "fixture-marketplace"
+    assert current.marketplace_plugin_name == "fixture-parent"
+    assert current.source_url == "https://example.invalid/marketplace.yml"
+    assert current.source_digest == "sha256:fixture"
+
+
+@pytest.mark.parametrize(
+    ("previous_commit", "current_commit"),
+    [
+        (None, None),
+        ("a" * 40, "b" * 40),
+    ],
+)
+def test_marketplace_provenance_is_not_inherited_without_same_nonempty_commit(
+    previous_commit: str | None,
+    current_commit: str | None,
+) -> None:
+    previous = LockedDependency(
+        repo_url="acme/parent",
+        resolved_commit=previous_commit,
+        discovered_via="fixture-marketplace",
+        marketplace_plugin_name="fixture-parent",
+        source_url="https://example.invalid/marketplace.yml",
+        source_digest="sha256:fixture",
+    )
+    current = LockedDependency(
+        repo_url="acme/parent",
+        resolved_commit=current_commit,
+    )
+    rebuilt = _lockfile_with(current)
+
+    LockfileBuilder(
+        SimpleNamespace(existing_lockfile=_lockfile_with(previous))
+    )._preserve_existing_marketplace_provenance(rebuilt)
+
+    assert current.discovered_via is None
+    assert current.marketplace_plugin_name is None
+    assert current.source_url is None
+    assert current.source_digest is None
