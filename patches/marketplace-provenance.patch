+    def _preserve_existing_marketplace_provenance(self, lockfile: LockFile) -> None:
+        """Carry origin metadata when frozen/normal replay keeps the same bytes."""
+        existing = self.ctx.existing_lockfile
+        if not existing:
+            return
+        for key, dep in lockfile.dependencies.items():
+            prev = existing.get_dependency(key)
+            if (
+                prev is None
+                or not dep.resolved_commit
+                or dep.resolved_commit != prev.resolved_commit
+            ):
+                continue
+            if not dep.discovered_via:
+                dep.discovered_via = prev.discovered_via
+            if not dep.marketplace_plugin_name:
+                dep.marketplace_plugin_name = prev.marketplace_plugin_name
+            if not dep.source_url:
+                dep.source_url = prev.source_url
+            if not dep.source_digest:
+                dep.source_digest = prev.source_digest
